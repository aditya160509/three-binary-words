(set-logic QF_LRA)
(declare-const a Real)
(assert (and (<= 0 a) (< a 1)))
(declare-const b Real)
(assert (and (<= 0 b) (< b 1)))
(declare-const p0 Real)
(assert (and (<= 0 p0) (< p0 1)))
(declare-const p1 Real)
(assert (and (<= 0 p1) (< p1 1)))
(declare-const p2 Real)
(assert (and (<= 0 p2) (< p2 1)))
(declare-const p3 Real)
(assert (and (<= 0 p3) (< p3 1)))
(assert (= p0 0))
(assert (< p0 p1))
(assert (< p1 p2))
(assert (< p2 p3))
(declare-const e0_0 Bool)
(assert (=> e0_0 (= (ite (< (+ p0 a) 1) (+ p0 a) (- (+ p0 a) 1)) (ite (< (+ p0 0) 1) (+ p0 0) (- (+ p0 0) 1)))))
(declare-const e0_1 Bool)
(assert (=> e0_1 (= (ite (< (+ p0 a) 1) (+ p0 a) (- (+ p0 a) 1)) (ite (< (+ p1 a) 1) (+ p1 a) (- (+ p1 a) 1)))))
(declare-const e0_2 Bool)
(assert (=> e0_2 (= (ite (< (+ p0 a) 1) (+ p0 a) (- (+ p0 a) 1)) (ite (< (+ p2 b) 1) (+ p2 b) (- (+ p2 b) 1)))))
(declare-const e0_3 Bool)
(assert (=> e0_3 (= (ite (< (+ p0 a) 1) (+ p0 a) (- (+ p0 a) 1)) (ite (< (+ p3 a) 1) (+ p3 a) (- (+ p3 a) 1)))))
(declare-const e1_0 Bool)
(assert (=> e1_0 (= (ite (< (+ p1 0) 1) (+ p1 0) (- (+ p1 0) 1)) (ite (< (+ p0 0) 1) (+ p0 0) (- (+ p0 0) 1)))))
(declare-const e1_1 Bool)
(assert (=> e1_1 (= (ite (< (+ p1 0) 1) (+ p1 0) (- (+ p1 0) 1)) (ite (< (+ p1 a) 1) (+ p1 a) (- (+ p1 a) 1)))))
(declare-const e1_2 Bool)
(assert (=> e1_2 (= (ite (< (+ p1 0) 1) (+ p1 0) (- (+ p1 0) 1)) (ite (< (+ p2 b) 1) (+ p2 b) (- (+ p2 b) 1)))))
(declare-const e1_3 Bool)
(assert (=> e1_3 (= (ite (< (+ p1 0) 1) (+ p1 0) (- (+ p1 0) 1)) (ite (< (+ p3 a) 1) (+ p3 a) (- (+ p3 a) 1)))))
(declare-const e2_0 Bool)
(assert (=> e2_0 (= (ite (< (+ p2 a) 1) (+ p2 a) (- (+ p2 a) 1)) (ite (< (+ p0 0) 1) (+ p0 0) (- (+ p0 0) 1)))))
(declare-const e2_1 Bool)
(assert (=> e2_1 (= (ite (< (+ p2 a) 1) (+ p2 a) (- (+ p2 a) 1)) (ite (< (+ p1 a) 1) (+ p1 a) (- (+ p1 a) 1)))))
(declare-const e2_2 Bool)
(assert (=> e2_2 (= (ite (< (+ p2 a) 1) (+ p2 a) (- (+ p2 a) 1)) (ite (< (+ p2 b) 1) (+ p2 b) (- (+ p2 b) 1)))))
(declare-const e2_3 Bool)
(assert (=> e2_3 (= (ite (< (+ p2 a) 1) (+ p2 a) (- (+ p2 a) 1)) (ite (< (+ p3 a) 1) (+ p3 a) (- (+ p3 a) 1)))))
(declare-const e3_0 Bool)
(assert (=> e3_0 (= (ite (< (+ p3 b) 1) (+ p3 b) (- (+ p3 b) 1)) (ite (< (+ p0 0) 1) (+ p0 0) (- (+ p0 0) 1)))))
(declare-const e3_1 Bool)
(assert (=> e3_1 (= (ite (< (+ p3 b) 1) (+ p3 b) (- (+ p3 b) 1)) (ite (< (+ p1 a) 1) (+ p1 a) (- (+ p1 a) 1)))))
(declare-const e3_2 Bool)
(assert (=> e3_2 (= (ite (< (+ p3 b) 1) (+ p3 b) (- (+ p3 b) 1)) (ite (< (+ p2 b) 1) (+ p2 b) (- (+ p2 b) 1)))))
(declare-const e3_3 Bool)
(assert (=> e3_3 (= (ite (< (+ p3 b) 1) (+ p3 b) (- (+ p3 b) 1)) (ite (< (+ p3 a) 1) (+ p3 a) (- (+ p3 a) 1)))))
(assert (or e0_0 e0_1 e0_2 e0_3))
(assert (or (not e0_0) (not e0_1)))
(assert (or (not e0_0) (not e0_2)))
(assert (or (not e0_0) (not e0_3)))
(assert (or (not e0_1) (not e0_2)))
(assert (or (not e0_1) (not e0_3)))
(assert (or (not e0_2) (not e0_3)))
(assert (or e0_0 e1_0 e2_0 e3_0))
(assert (or (not e0_0) (not e1_0)))
(assert (or (not e0_0) (not e2_0)))
(assert (or (not e0_0) (not e3_0)))
(assert (or (not e1_0) (not e2_0)))
(assert (or (not e1_0) (not e3_0)))
(assert (or (not e2_0) (not e3_0)))
(assert (or e1_0 e1_1 e1_2 e1_3))
(assert (or (not e1_0) (not e1_1)))
(assert (or (not e1_0) (not e1_2)))
(assert (or (not e1_0) (not e1_3)))
(assert (or (not e1_1) (not e1_2)))
(assert (or (not e1_1) (not e1_3)))
(assert (or (not e1_2) (not e1_3)))
(assert (or e0_1 e1_1 e2_1 e3_1))
(assert (or (not e0_1) (not e1_1)))
(assert (or (not e0_1) (not e2_1)))
(assert (or (not e0_1) (not e3_1)))
(assert (or (not e1_1) (not e2_1)))
(assert (or (not e1_1) (not e3_1)))
(assert (or (not e2_1) (not e3_1)))
(assert (or e2_0 e2_1 e2_2 e2_3))
(assert (or (not e2_0) (not e2_1)))
(assert (or (not e2_0) (not e2_2)))
(assert (or (not e2_0) (not e2_3)))
(assert (or (not e2_1) (not e2_2)))
(assert (or (not e2_1) (not e2_3)))
(assert (or (not e2_2) (not e2_3)))
(assert (or e0_2 e1_2 e2_2 e3_2))
(assert (or (not e0_2) (not e1_2)))
(assert (or (not e0_2) (not e2_2)))
(assert (or (not e0_2) (not e3_2)))
(assert (or (not e1_2) (not e2_2)))
(assert (or (not e1_2) (not e3_2)))
(assert (or (not e2_2) (not e3_2)))
(assert (or e3_0 e3_1 e3_2 e3_3))
(assert (or (not e3_0) (not e3_1)))
(assert (or (not e3_0) (not e3_2)))
(assert (or (not e3_0) (not e3_3)))
(assert (or (not e3_1) (not e3_2)))
(assert (or (not e3_1) (not e3_3)))
(assert (or (not e3_2) (not e3_3)))
(assert (or e0_3 e1_3 e2_3 e3_3))
(assert (or (not e0_3) (not e1_3)))
(assert (or (not e0_3) (not e2_3)))
(assert (or (not e0_3) (not e3_3)))
(assert (or (not e1_3) (not e2_3)))
(assert (or (not e1_3) (not e3_3)))
(assert (or (not e2_3) (not e3_3)))
(assert (distinct a b 0))
(check-sat)
